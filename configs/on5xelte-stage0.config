# SPDX-License-Identifier: GPL-2.0-only
# Merge onto arm64 allnoconfig, then strictly check after olddefconfig.
CONFIG_LOCALVERSION="-on5xelte-stage0"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_ARM64=y
CONFIG_ARCH_EXYNOS=y
# ARM64 unconditionally selects this class; no supply drivers are enabled.
CONFIG_POWER_SUPPLY=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
# Keep the linker workaround applicable to this Cortex-A53 r0p4 CPU.
CONFIG_ARM64_ERRATUM_843419=y
# CONFIG_COMPAT is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RELOCATABLE is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_ARM_ARCH_TIMER_EVTSTREAM is not set

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
# CONFIG_BINFMT_SCRIPT is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y

CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_FONT_8x16=y
# CONFIG_LOGO is not set
# CONFIG_DRM is not set

# No unvalidated UART, storage, power-management or external device probes.
# CONFIG_SERIAL_SAMSUNG is not set
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_NVMEM is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_REGULATOR is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_BPF_SYSCALL is not set

CONFIG_CMDLINE="console=tty0 consoleblank=0 loglevel=8 ignore_loglevel initcall_debug clk_ignore_unused nokaslr maxcpus=1 panic=0 rdinit=/init"
CONFIG_CMDLINE_FORCE=y

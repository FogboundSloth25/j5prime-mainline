Subject: [LOCAL, EXPERIMENTAL] clk: add narrowly scoped Exynos7570 stage0 providers

Register the independently written source supplied under kernel/ and describe
its two intentionally limited clock providers. CMU_MIF is read-only; only the
MCT PCLK gate in CMU_PERI is managed. Firmware must retain the shared PLL/mux/
divider/bus-gate path. These local compatibles are not upstream submissions.

diff --git a/drivers/clk/samsung/Kconfig b/drivers/clk/samsung/Kconfig
--- a/drivers/clk/samsung/Kconfig
+++ b/drivers/clk/samsung/Kconfig
@@ -76,6 +76,15 @@ config EXYNOS_ARM64_COMMON_CLK
 	bool "Samsung Exynos ARMv8-family clock controller support" if COMPILE_TEST
 	depends on COMMON_CLK_SAMSUNG
 
+config EXYNOS_7570_STAGE0_CLK
+	bool "Experimental Exynos7570 stage0 MCT clock support"
+	depends on ARM64 && ARCH_EXYNOS && COMMON_CLK_SAMSUNG
+	help
+	  Provide the MCT PCLK gate and a checked, read-only view of its
+	  inherited CMU_MIF PERI bus parent. This is not a complete clock
+	  controller driver and does not configure shared PLLs or DRAM clocks.
+	  Choose Y only for the local diagnostic Exynos7570 stage0 DTB.
+
 config EXYNOS_AUDSS_CLK_CON
 	tristate "Samsung Exynos AUDSS clock controller support"
 	depends on COMMON_CLK_SAMSUNG
diff --git a/drivers/clk/samsung/Makefile b/drivers/clk/samsung/Makefile
--- a/drivers/clk/samsung/Makefile
+++ b/drivers/clk/samsung/Makefile
@@ -23,6 +23,7 @@ obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos7.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos7870.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos7885.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos850.o
+obj-$(CONFIG_EXYNOS_7570_STAGE0_CLK)	+= clk-exynos7570-stage0.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos8895.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynos990.o
 obj-$(CONFIG_EXYNOS_ARM64_COMMON_CLK)	+= clk-exynosautov9.o
diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos7570-stage0-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos7570-stage0-clock.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos7570-stage0-clock.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/samsung,exynos7570-stage0-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Experimental Samsung Exynos7570 stage0 clock providers
+
+maintainers:
+  - FogboundSloth25 <FogboundSloth25@users.noreply.github.com>
+
+description: |
+  Local diagnostic bindings, not a complete SoC clock-controller ABI.
+  The MIF provider exports only the firmware-retained PERI bus clock. It
+  reads and validates the selected shared PLL, muxes, divider and output
+  gate, but cannot change them. The PERI provider exports only the MCT PCLK
+  gate. The MCT's separate fin_pll tick source remains the 26 MHz oscillator.
+  Neither provider supplies display, storage, UART or power-management clocks.
+
+properties:
+  compatible:
+    enum:
+      - samsung,exynos7570-cmu-mif-stage0
+      - samsung,exynos7570-cmu-peri-stage0
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: samsung,exynos7570-cmu-mif-stage0
+    then:
+      properties:
+        clock-names:
+          items:
+            - const: oscclk
+    else:
+      properties:
+        clock-names:
+          items:
+            - const: peri-bus
+
+additionalProperties: false
+
+examples:
+  - |
+    cmu_mif: clock-controller@10460000 {
+        compatible = "samsung,exynos7570-cmu-mif-stage0";
+        reg = <0x10460000 0x1000>;
+        clocks = <&oscclk>;
+        clock-names = "oscclk";
+        #clock-cells = <0>;
+    };
+
+    clock-controller@101f0000 {
+        compatible = "samsung,exynos7570-cmu-peri-stage0";
+        reg = <0x101f0000 0x1000>;
+        clocks = <&cmu_mif>;
+        clock-names = "peri-bus";
+        #clock-cells = <0>;
+    };
